@{
    ViewData["Title"] = "Admin Panel";
    var events = (List<StudentEngagementPortal.Models.Event>)ViewBag.Events;
    var openMessages = (List<StudentEngagementPortal.Models.Message>)ViewBag.OpenMessages;
}

<h1 class="mb-4">Admin Panel</h1>

<div class="row">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Events</h3>
            <a asp-action="CreateEvent" class="btn btn-primary btn-sm">+ New Event</a>
        </div>

        @if (!events.Any())
        {
            <p class="text-muted">No events yet.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Signups</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in events)
                    {
                        <tr>
                            <td>@ev.Title</td>
                            <td>@ev.StartsAt.ToString("MMM d, yyyy")</td>
                            <td>@ev.Registrations.Count / @ev.MaxParticipants</td>
                            <td>
                                <a asp-action="SignupList" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-secondary">Signups</a>
                                <a asp-action="EditEvent" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="DeleteEvent" asp-route-id="@ev.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
            <h3>Announcements</h3>
            <a asp-action="PostAnnouncement" class="btn btn-primary btn-sm">+ Post Announcement</a>
        </div>
    </div>

    <div class="col-md-4">
        <h3>Support Queue</h3>
        @if (!openMessages.Any())
        {
            <p class="text-muted">No open messages.</p>
        }
        else
        {
            @foreach (var msg in openMessages)
            {
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <h6 class="card-title mb-1">@msg.Subject</h6>
                        <p class="card-text small text-muted mb-2">@msg.Body</p>
                        <form asp-action="ResolveMessage" asp-route-id="@msg.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-success">Mark Resolved</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>