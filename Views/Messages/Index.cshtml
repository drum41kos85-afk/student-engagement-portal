@model List<StudentEngagementPortal.Models.Message>

@{
    ViewData["Title"] = "My Messages";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Messages</h1>
    <a asp-action="Create" class="btn btn-primary">New Message</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">You haven't submitted any messages yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Submitted</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var msg in Model)
            {
                <tr>
                    <td>@msg.Subject</td>
                    <td>@msg.SubmittedAt.ToString("MMM d, yyyy")</td>
                    <td>
                        @if (msg.Status == StudentEngagementPortal.Models.MessageStatus.Open)
                        {
                            <span class="badge bg-warning text-dark">Open</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Resolved</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}